# Synthetic local-only example. Copy to .env for local Compose use.
# Every value below is an obvious placeholder; never put real secrets here.

# Host port for the single local origin (bound to 127.0.0.1 only).
PROXY_PORT=8480

# Django. The placeholder key is accepted ONLY while DJANGO_DEBUG=1;
# settings refuse to start with DEBUG off and this value.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-local-only-placeholder-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8480,http://127.0.0.1:8480
DJANGO_SECURE_COOKIES=0
DJANGO_TRUST_PROXY_PROTO_HEADER=0
DJANGO_LOG_LEVEL=INFO

# PostgreSQL (internal Compose network only; not published to the host).
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=hardware_store
POSTGRES_USER=hardware_store
POSTGRES_PASSWORD=change-me-local-postgres-password

# Single-organization MVP: organization used for guest catalog requests (P1-02A).
DJANGO_DEFAULT_ORGANIZATION_SLUG=demo
# Only these peers may set X-Forwarded-For (IPs, CIDRs or Compose hostnames).
DJANGO_TRUSTED_PROXY_HOSTS=proxy
